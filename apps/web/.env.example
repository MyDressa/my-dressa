
# ── Design-Schalter ──────────────────────────────────────────────
# Neues Design (Preis-Erzählung, Hover-Bild, Verfügbarkeit, Kreislauf)
# ist standardmäßig AN. Zum Zurückschalten auf die alte Ansicht:
# NEXT_PUBLIC_NEW_DESIGN=0
#
# Prozentangabe "Miete = 18 % des Kaufpreises" separat abschaltbar:
# NEXT_PUBLIC_PRICE_RATIO=0
#
# Kreislauf-Grafik ("Das Kleid bleibt in Bewegung") ist standardmäßig AUS.
# Es wird die klassische "So funktioniert es"-Sektion gezeigt.
# Zum Aktivieren der Ring-Variante:
# NEXT_PUBLIC_CYCLE=1
